{
  "name": "gt-lmsa-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/lib/*.test.ts tests/validation.test.ts tests/ui-dates.test.ts tests/api-helper.test.ts tests/test-database.test.ts tests/migration-target.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:integration": "tsx --test --test-concurrency=1 tests/*.integration.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:grant-officer": "tsx scripts/grant-officer.ts"
  },
  "dependencies": {
    "better-auth": "1.7.6",
    "next": "^15.3.3",
    "pg": "8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.15.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "better-call": "1.4.0",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3"
  }
}
